name = "bookeater-api"
main = "src/index.ts"
compatibility_date = "2026-09-01"

[[d1_databases]]
binding = "DB"
database_name = "bookeater-feedback"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

[triggers]
crons = ["17 3 * * *"]

# Set the Aladin key only as a Worker secret; never commit it or bundle it in the desktop app:
#   npx wrangler secret put ALADIN_TTB_KEY
